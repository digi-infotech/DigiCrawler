# Fallback country for phone numbers written without a +country code, used only when a website
# gives no clue itself (domain ending, address...). IN = India, US = United States, GB = United Kingdom.
# The web page can override it.
REGION=IN
# How many websites to check at the same time.
CONCURRENCY=20
# Max pages to open per website (homepage + contact/about/services pages).
MAX_PAGES=6
# Seconds to wait for a website before giving up.
TIMEOUT=15
# Respect robots.txt rules (true/false). Off: every website is opened like a person would,
# whatever its robots.txt says.
RESPECT_ROBOTS=false
# Automatic browser fallback: when a website refuses plain visits (403, "Access denied"), shows
# nothing without JavaScript, or blocks its contact page, a real headless Chrome opens it instead.
# Makes the Docker image ~2 GB instead of ~285 MB. Set to false for the light version.
# After changing this, run: docker compose up -d --build
WITH_BROWSER=true
# How many websites may use the browser at the same time (each uses ~150-300 MB of memory).
BROWSER_CONCURRENCY=3
# When the internet connection drops (or the laptop sleeps), pause the check and carry on once it's
# back, instead of marking every website as failed. The connection test uses these hosts (any one
# answering = online); change them if a firewall blocks them.
ONLINE_CHECK=true
# ONLINE_CHECK_HOSTS=www.google.com:443,one.one.one.one:443,www.microsoft.com:443
# Most websites allowed in one uploaded file. Bigger files take longer (about 1-2 s per website)
# and need more memory when the Excel result is saved. After changing it, restart the app:
# docker compose up -d
MAX_ROWS=20000
# Port to open in your browser: http://localhost:3003
PORT=3003
